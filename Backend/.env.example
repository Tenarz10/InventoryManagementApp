PORT=5500
MONGO_URI=your_mongodb_connection_string
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Comma-separated frontend origins allowed by CORS (leave empty to allow all in development)
CORS_ORIGIN=http://localhost:5173
# Set to false to stop public sign-up; admins then create accounts via /api/users
ALLOW_REGISTRATION=true
# Set to 1 when running behind a reverse proxy so rate limiting sees the real client IP
TRUST_PROXY=0
# Used once by `npm run create-admin` to create the first admin account
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
